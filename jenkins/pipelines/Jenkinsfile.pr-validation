// ─── Stage 1: PR Validation Pipeline ─────────────────────────────────
// Triggers on every Pull Request via GitHub webhook.
// Gates: compile, unit tests, SonarQube quality gate, Angular lint.
// PR cannot merge unless ALL gates pass.
// ─────────────────────────────────────────────────────────────────────

@Library('shopmicro-shared') _

pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds(abortPrevious: true)
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        JAVA_HOME   = tool name: 'jdk-21',    type: 'jdk'
        MAVEN_HOME  = tool name: 'maven-3.9', type: 'maven'
        PATH        = "${JAVA_HOME}/bin;${MAVEN_HOME}/bin;${PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    env.CHANGES = detectChanges('HEAD~1')
                    echo "Changed services: ${env.CHANGES.services}"
                    if (env.CHANGES.total == 0) {
                        currentBuild.result = 'NOT_BUILT'
                        echo 'No changes detected — skipping'
                        return
                    
                    }
                }
            }
        }

        stage('Build & Test') {
            when { expression { env.CHANGES?.hasJava } }
            steps {
                script {
                    def modules = env.CHANGES.services.join(',')
                    bat """
                        mvn -B -pl "${modules}" -am clean verify ^
                            -Dmaven.test.failure.ignore=false ^
                            -q
                    """
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: '**/target/surefire-reports/*.xml'
                }
            }
        }

        stage('SonarQube') {
            when { expression { env.CHANGES?.hasJava } }
            steps {
                withSonarQubeEnv('sonarqube') {
                    script {
                        def modules = env.CHANGES.services.join(',')
                        bat """
                            mvn -B -pl "${modules}" sonar:sonar ^
                                -Dsonar.projectKey=shopmicro
                        """
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { expression { env.CHANGES?.hasJava } }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Frontend Lint') {
            when { expression { env.CHANGES?.frontendChanged } }
            tools { nodejs 'nodejs-20' }
            steps {
                dir('microservices-app') {
                    bat 'npm ci --prefer-offline'
                    bat 'npm run lint -- --max-warnings=0'
                }
            }
        }
    }

    post {
        success { echo '✅ PR validation passed — merge allowed' }
        failure { echo '❌ PR validation failed — merge blocked' }
        always  { cleanWs() }
    }
}
