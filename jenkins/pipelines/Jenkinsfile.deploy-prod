// ─── Stage 5: Deploy Production ───────────────────────────────────────
// Triggered after QA approval.
// Tags current images as backup → deploys new images → health check → auto-rollback if failed.
// ─────────────────────────────────────────────────────────────────────

@Library('shopmicro-shared') _

pipeline {
    agent any

    parameters {
        string(name: 'VERSION', description: 'Version approved from QA')
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '50'))
    }

    environment {
        ENV          = 'prod'
        REGISTRY_URL = 'localhost:5000'
        IMAGE_TAG    = "${params.VERSION}"
        GATEWAY_URL  = 'http://localhost:8080'
        COMPOSE_FILE = 'infra/docker-compose.prod.yml'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── Tag current running images as rollback backup ──
        stage('Snapshot for Rollback') {
            steps {
                script {
                    def services = [
                        'eureka-server', 'api-gateway', 'auth-service',
                        'product-service', 'inventory-service', 'cart-service',
                        'order-service', 'payment-service', 'notification-service'
                    ]
                    services.each { svc ->
                        bat(
                            script: "docker tag ${env.REGISTRY_URL}/shopmicro/${svc}:latest ${env.REGISTRY_URL}/shopmicro/${svc}:rollback 2>nul",
                            returnStatus: true
                        )
                    }
                    echo "✅ Current images tagged as :rollback"
                }
            }
        }

        stage('Stop Old Prod Containers') {
            steps {
                bat "docker-compose -f ${env.COMPOSE_FILE} down --remove-orphans 2>nul || echo No prod containers running"
                sleep(time: 10, unit: 'SECONDS')
            }
        }

        stage('Pull New Images') {
            steps {
                script {
                    def services = [
                        'eureka-server', 'api-gateway', 'auth-service',
                        'product-service', 'inventory-service', 'cart-service',
                        'order-service', 'payment-service', 'notification-service'
                    ]
                    services.each { svc ->
                        bat "docker pull ${env.REGISTRY_URL}/shopmicro/${svc}:${env.IMAGE_TAG}"
                        // Also tag as latest so compose can use it
                        bat "docker tag ${env.REGISTRY_URL}/shopmicro/${svc}:${env.IMAGE_TAG} ${env.REGISTRY_URL}/shopmicro/${svc}:latest"
                    }
                }
            }
        }

        stage('Deploy Production') {
            steps {
                bat """
                    set REGISTRY_URL=${env.REGISTRY_URL}
                    set IMAGE_TAG=${env.IMAGE_TAG}
                    docker-compose -f ${env.COMPOSE_FILE} up -d --force-recreate
                """
                echo "⏳ Waiting 90s for prod services to start..."
                sleep(time: 90, unit: 'SECONDS')
            }
        }

        stage('Health Check') {
            steps {
                script {
                    def services = [
                        [name: 'eureka-server',       port: 8761],
                        [name: 'api-gateway',          port: 8080],
                        [name: 'auth-service',         port: 8081],
                        [name: 'product-service',      port: 8082],
                        [name: 'inventory-service',    port: 8083],
                        [name: 'cart-service',         port: 8084],
                        [name: 'payment-service',      port: 8085],
                        [name: 'order-service',        port: 8086],
                        [name: 'notification-service', port: 8087]
                    ]

                    def maxWait = 180
                    def interval = 10
                    def elapsed = 0
                    def allUp = false

                    while (elapsed < maxWait && !allUp) {
                        allUp = true
                        services.each { svc ->
                            def status = bat(
                                script: "curl -s -o nul -w \"%%{http_code}\" http://localhost:${svc.port}/actuator/health --max-time 5 2>nul",
                                returnStdout: true
                            ).trim().readLines().last()
                            if (status != '200') {
                                allUp = false
                            }
                        }
                        if (!allUp) {
                            sleep(time: interval, unit: 'SECONDS')
                            elapsed += interval
                        }
                    }

                    env.DEPLOY_HEALTHY = allUp.toString()

                    if (!allUp) {
                        error "❌ Health check failed — triggering rollback"
                    }
                    echo "✅ All prod services healthy!"
                }
            }
        }

        stage('Deployment Audit') {
            steps {
                script {
                    echo """
                    ═══════════════════════════════════════════════════
                      PRODUCTION DEPLOYMENT AUDIT — ShopMicro
                    ═══════════════════════════════════════════════════
                      Version     : ${params.VERSION}
                      Outcome     : SUCCESS
                      Commit      : ${env.GIT_COMMIT ?: 'N/A'}
                      Build #     : ${env.BUILD_NUMBER}
                      Registry    : ${env.REGISTRY_URL}
                      Timestamp   : ${new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))}
                    ═══════════════════════════════════════════════════
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ Production deployment successful — ${params.VERSION}"
            notifyDeploy(status: 'SUCCESS', environment: 'prod', version: params.VERSION)
        }
        failure {
            script {
                echo '🚨 ROLLING BACK production to previous version'
                def services = [
                    'eureka-server', 'api-gateway', 'auth-service',
                    'product-service', 'inventory-service', 'cart-service',
                    'order-service', 'payment-service', 'notification-service'
                ]
                // Stop failed containers
                bat "docker-compose -f ${env.COMPOSE_FILE} down --remove-orphans 2>nul || echo done"
                // Restore rollback images as latest
                services.each { svc ->
                    bat(
                        script: "docker tag ${env.REGISTRY_URL}/shopmicro/${svc}:rollback ${env.REGISTRY_URL}/shopmicro/${svc}:latest 2>nul",
                        returnStatus: true
                    )
                }
                // Restart with rollback images
                bat """
                    set REGISTRY_URL=${env.REGISTRY_URL}
                    set IMAGE_TAG=rollback
                    docker-compose -f ${env.COMPOSE_FILE} up -d
                """
                echo "✅ Rollback complete"
                notifyDeploy(status: 'ROLLBACK', environment: 'prod', version: params.VERSION)
            }
        }
        always { cleanWs() }
    }
}
