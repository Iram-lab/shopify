// ─── Stage 4: Deploy QA ───────────────────────────────────────────────
// Auto-triggered after dev passes.
// Runs same images on QA ports (9xxx) via docker-compose.qa.yml.
// Requires manual approval before promoting to prod.
// ─────────────────────────────────────────────────────────────────────

@Library('shopmicro-shared') _

pipeline {
    agent any

    parameters {
        string(name: 'VERSION', description: 'Version promoted from dev')
    }

    options {
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        ENV          = 'qa'
        REGISTRY_URL = 'localhost:5000'
        IMAGE_TAG    = "${params.VERSION}"
        GATEWAY_URL  = 'http://localhost:9080'
        COMPOSE_FILE = 'infra/docker-compose.qa.yml'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Stop Old QA Containers') {
            steps {
                bat "docker-compose -f ${env.COMPOSE_FILE} down --remove-orphans 2>nul || echo No QA containers running"
            }
        }

        stage('Pull Images') {
            steps {
                script {
                    def services = [
                        'eureka-server', 'api-gateway', 'auth-service',
                        'product-service', 'inventory-service', 'cart-service',
                        'order-service', 'payment-service', 'notification-service'
                    ]
                    services.each { svc ->
                        bat "docker pull ${env.REGISTRY_URL}/shopmicro/${svc}:${env.IMAGE_TAG}"
                    }
                }
            }
        }

        stage('Deploy QA') {
            steps {
                bat """
                    set REGISTRY_URL=${env.REGISTRY_URL}
                    set IMAGE_TAG=${env.IMAGE_TAG}
                    docker-compose -f ${env.COMPOSE_FILE} up -d --force-recreate
                """
                echo "⏳ Waiting 60s for QA services to start..."
                sleep(time: 60, unit: 'SECONDS')
            }
        }

        stage('Health Check') {
            steps {
                script {
                    def services = [
                        [name: 'eureka-server',       port: 9761],
                        [name: 'api-gateway',          port: 9080],
                        [name: 'auth-service',         port: 9081],
                        [name: 'product-service',      port: 9082],
                        [name: 'inventory-service',    port: 9083],
                        [name: 'cart-service',         port: 9084],
                        [name: 'payment-service',      port: 9085],
                        [name: 'order-service',        port: 9086],
                        [name: 'notification-service', port: 9087]
                    ]

                    def maxWait = 120
                    def interval = 10
                    def elapsed = 0
                    def allUp = false

                    while (elapsed < maxWait && !allUp) {
                        allUp = true
                        services.each { svc ->
                            def status = bat(
                                script: "curl -s -o nul -w \"%%{http_code}\" http://localhost:${svc.port}/actuator/health --max-time 5 2>nul",
                                returnStdout: true
                            ).trim().readLines().last()
                            if (status != '200') {
                                allUp = false
                                echo "  ⏳ ${svc.name} not ready (${elapsed}s)"
                            } else {
                                echo "  ✅ ${svc.name} UP"
                            }
                        }
                        if (!allUp) {
                            sleep(time: interval, unit: 'SECONDS')
                            elapsed += interval
                        }
                    }

                    if (!allUp) {
                        bat "docker-compose -f ${env.COMPOSE_FILE} logs --tail=50"
                        error "❌ Not all QA services healthy within ${maxWait}s"
                    }
                    echo "✅ All QA services healthy!"
                }
            }
        }

        stage('Regression Tests') {
            steps {
                script {
                    def collections = findFiles(glob: 'infra/postman/**/*.postman_collection.json')
                    if (collections.size() == 0) {
                        echo 'No Postman collections found — skipping'
                        return
                    }
                    def failed = 0
                    collections.each { col ->
                        def status = bat(
                            script: """
                                newman run "${col.path}" ^
                                    --env-var "baseUrl=${env.GATEWAY_URL}" ^
                                    --env-var "env=qa" ^
                                    --reporters cli,json ^
                                    --reporter-json-export "results-${col.name}.json" ^
                                    --timeout-request 30000
                            """,
                            returnStatus: true
                        )
                        if (status != 0) failed++
                    }
                    if (failed > 0) unstable "${failed} regression test(s) failed"
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'results-*.json', allowEmptyArchive: true
                }
            }
        }

        stage('Approve for Production') {
            steps {
                script {
                    input(
                        message: "Deploy version ${params.VERSION} to PRODUCTION?",
                        ok: 'Approve & Deploy'
                    )
                    echo "✅ Production deployment approved"
                }
            }
        }
    }

    post {
        success {
            echo "✅ QA passed — ${params.VERSION} approved for production"
            notifyDeploy(status: 'SUCCESS', environment: 'qa', version: params.VERSION)
            build job: 'shopmicro-deploy-prod',
                  parameters: [string(name: 'VERSION', value: params.VERSION)],
                  wait: false
        }
        failure {
            echo '❌ QA deployment failed'
            notifyDeploy(status: 'FAILURE', environment: 'qa', version: params.VERSION)
        }
        aborted {
            echo '⚠️ Production approval rejected'
            notifyDeploy(status: 'UNSTABLE', environment: 'qa', version: params.VERSION)
        }
        always { cleanWs() }
    }
}
