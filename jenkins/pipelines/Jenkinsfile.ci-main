// ─── Stage 2: CI Main Pipeline ────────────────────────────────────────
// Triggers on every push/merge to main branch.
// Flow: Checkout → Version → Build JARs → Docker Build+Push → Frontend → Trigger Dev
// Uses local Docker registry at localhost:5000
// ─────────────────────────────────────────────────────────────────────

@Library('shopmicro-shared') _

pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '30'))
    }

    environment {
        JAVA_HOME    = tool name: 'jdk-21',    type: 'jdk'
        MAVEN_HOME   = tool name: 'maven-3.9', type: 'maven'
        PATH         = "${JAVA_HOME}/bin;${MAVEN_HOME}/bin;${PATH}"
        REGISTRY_URL = 'localhost:5000'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Version') {
            steps {
                script {
                    def shortSha = bat(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim().readLines().last()

                    env.VERSION   = "1.0.${env.BUILD_NUMBER}-${shortSha}"
                    env.IMAGE_TAG = env.VERSION
                    echo "Version: ${env.VERSION}"
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    env.CHANGES = detectChanges('HEAD~1')
                    echo "Building ${env.CHANGES.total} component(s)"
                }
            }
        }

        stage('Changelog') {
            steps {
                script {
                    generateChangelog(version: env.VERSION)
                }
            }
        }

        // ── Build all 9 services in parallel: Maven + Docker build + Docker push ──
        stage('Build & Push Images') {
            steps {
                script {
                    def allServices = [
                        'microservices-backend/eureka-server',
                        'microservices-backend/api-gateway',
                        'microservices-backend/auth-service',
                        'microservices-backend/product-service',
                        'microservices-backend/inventory-service',
                        'microservices-backend/cart-service',
                        'microservices-backend/order-service',
                        'microservices-backend/payment-service',
                        'microservices-backend/notification-service'
                    ]

                    def parallelBuilds = [:]
                    allServices.each { svc ->
                        def name = svc.split('/').last()
                        def path = svc
                        parallelBuilds[name] = {
                            buildService(servicePath: path, version: env.VERSION)
                        }
                    }
                    parallel parallelBuilds
                }
            }
        }

        stage('Frontend Build') {
            tools { nodejs 'nodejs-20' }
            steps {
                dir('microservices-app') {
                    bat 'npm ci --prefer-offline'
                    bat 'npm run build -- --configuration production'
                }
                echo "✅ Frontend built"
            }
        }

        stage('Audit') {
            steps {
                script {
                    echo """
                    ═══════════════════════════════════════════════════
                      BUILD AUDIT — ShopMicro
                    ═══════════════════════════════════════════════════
                      Version   : ${env.VERSION}
                      Commit    : ${env.GIT_COMMIT}
                      Branch    : ${env.GIT_BRANCH}
                      Build #   : ${env.BUILD_NUMBER}
                      Registry  : ${env.REGISTRY_URL}
                      Timestamp : ${new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC'))}
                    ═══════════════════════════════════════════════════
                    """
                }
            }
        }
    }

    post {
        success {
            echo "✅ CI complete — images pushed for version ${env.VERSION}"
            notifyDeploy(status: 'SUCCESS', environment: 'ci', version: env.VERSION)
            build job: 'shopmicro-deploy-dev',
                  parameters: [string(name: 'VERSION', value: env.VERSION)],
                  wait: false
        }
        failure {
            echo '❌ CI pipeline failed'
            notifyDeploy(status: 'FAILURE', environment: 'ci', version: env.VERSION ?: 'unknown')
        }
        always { cleanWs() }
    }
}
