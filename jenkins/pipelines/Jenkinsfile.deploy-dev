// ─── Stage 3: Deploy Dev ──────────────────────────────────────────────
// Auto-triggered after CI Main succeeds.
// Pulls Docker images from local registry and starts all services via docker-compose.
// Flow: Pull images → docker-compose up → Health check → Smoke test → Integration tests
// ─────────────────────────────────────────────────────────────────────

@Library('shopmicro-shared') _

pipeline {
    agent any

    parameters {
        string(name: 'VERSION', description: 'Version from CI Main pipeline')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        ENV          = 'dev'
        REGISTRY_URL = 'localhost:5000'
        IMAGE_TAG    = "${params.VERSION}"
        GATEWAY_URL  = 'http://localhost:8080'
        COMPOSE_FILE = 'infra/docker-compose.dev.yml'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // ── Stop and remove old dev containers ──
        stage('Stop Old Containers') {
            steps {
                bat "docker-compose -f ${env.COMPOSE_FILE} down --remove-orphans 2>nul || echo No containers running"
            }
        }

        // ── Pull latest images from registry ──
        stage('Pull Images') {
            steps {
                script {
                    def services = [
                        'eureka-server', 'api-gateway', 'auth-service',
                        'product-service', 'inventory-service', 'cart-service',
                        'order-service', 'payment-service', 'notification-service'
                    ]
                    services.each { svc ->
                        bat "docker pull ${env.REGISTRY_URL}/shopmicro/${svc}:${env.IMAGE_TAG}"
                    }
                }
            }
        }

        // ── Start all containers via docker-compose ──
        stage('Deploy Dev') {
            steps {
                bat """
                    set REGISTRY_URL=${env.REGISTRY_URL}
                    set IMAGE_TAG=${env.IMAGE_TAG}
                    docker-compose -f ${env.COMPOSE_FILE} up -d --force-recreate
                """
                echo "⏳ Waiting 60s for all services to start..."
                sleep(time: 60, unit: 'SECONDS')
            }
        }

        // ── Health check all containers ──
        stage('Health Check') {
            steps {
                script {
                    def services = [
                        [name: 'eureka-server',       port: 8761],
                        [name: 'api-gateway',          port: 8080],
                        [name: 'auth-service',         port: 8081],
                        [name: 'product-service',      port: 8082],
                        [name: 'inventory-service',    port: 8083],
                        [name: 'cart-service',         port: 8084],
                        [name: 'payment-service',      port: 8085],
                        [name: 'order-service',        port: 8086],
                        [name: 'notification-service', port: 8087]
                    ]

                    def maxWait = 120
                    def interval = 10
                    def elapsed = 0
                    def allUp = false

                    while (elapsed < maxWait && !allUp) {
                        allUp = true
                        services.each { svc ->
                            def status = bat(
                                script: "curl -s -o nul -w \"%%{http_code}\" http://localhost:${svc.port}/actuator/health --max-time 5 2>nul",
                                returnStdout: true
                            ).trim().readLines().last()
                            if (status != '200') {
                                allUp = false
                                echo "  ⏳ ${svc.name} not ready yet (${elapsed}s)"
                            } else {
                                echo "  ✅ ${svc.name} UP"
                            }
                        }
                        if (!allUp) {
                            sleep(time: interval, unit: 'SECONDS')
                            elapsed += interval
                        }
                    }

                    if (!allUp) {
                        bat "docker-compose -f ${env.COMPOSE_FILE} logs --tail=50"
                        error "❌ Not all services healthy within ${maxWait}s"
                    }
                    echo "✅ All services healthy!"
                }
            }
        }

        // ── Integration Tests via Newman ──
        stage('Integration Tests') {
            steps {
                script {
                    def collections = findFiles(glob: 'infra/postman/**/*.postman_collection.json')
                    if (collections.size() == 0) {
                        echo 'No Postman collections found — skipping'
                        return
                    }
                    def failed = 0
                    collections.each { col ->
                        def status = bat(
                            script: """
                                newman run "${col.path}" ^
                                    --env-var "baseUrl=${env.GATEWAY_URL}" ^
                                    --env-var "env=dev" ^
                                    --reporters cli,json ^
                                    --reporter-json-export "results-${col.name}.json" ^
                                    --timeout-request 30000
                            """,
                            returnStatus: true
                        )
                        if (status != 0) failed++
                    }
                    if (failed > 0) error "${failed} integration test collection(s) failed"
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'results-*.json', allowEmptyArchive: true
                }
            }
        }
    }

    post {
        success {
            echo "✅ Dev deployment passed for ${params.VERSION}"
            notifyDeploy(status: 'SUCCESS', environment: 'dev', version: params.VERSION)
            build job: 'shopmicro-deploy-qa',
                  parameters: [string(name: 'VERSION', value: params.VERSION)],
                  wait: false
        }
        failure {
            echo '❌ Dev deployment failed'
            bat "docker-compose -f ${env.COMPOSE_FILE} logs --tail=100 2>nul || echo No logs"
            notifyDeploy(status: 'FAILURE', environment: 'dev', version: params.VERSION)
        }
        always { cleanWs() }
    }
}
